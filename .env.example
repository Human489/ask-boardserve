# Copy to .env.local and fill in. NEVER commit real values.

# --- Access control ---
# Passcode required by middleware to view the deployed app
APP_PASSCODE=

# Signs the session cookie. Any random string; 32+ bytes is plenty:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it the cookie is signed with the passcode, which is short and
# human-chosen — so a leaked cookie could be worked back to the passcode
# itself. Rotating this value also signs every live session out, which is the
# only revocation this stateless design has.
SESSION_SECRET=

# --- Cloudflare ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# AI Gateway - all model calls route through this
# Requests must carry the header: cf-aig-gateway-id: default
CF_AI_GATEWAY_ID=default

# Vectorize index holding the embedded board papers
CF_VECTORIZE_INDEX=

# KV namespace: pinned dashboards, share tokens, rate limits, response cache
CF_KV_NAMESPACE_ID=

# --- App config ---
# Directory the dataset is loaded from (gitignored)
DATASET_PATH=./dataset

# Rate limiting: AI calls per minute per IP
RATE_LIMIT_PER_MINUTE=20
