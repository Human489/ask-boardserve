# ---------------------------------------------------------------
# NEVER COMMIT: board data and secrets
# ---------------------------------------------------------------
# Anchored to the repo root: an unanchored "dataset/" also matches
# src/lib/dataset/, which silently drops application code from commits.
/dataset/
/dataset-*/
/data/private/
*.dataset.json

# Environment variables / secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
secrets.json
.wrangler/

# ---------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/
/playwright-report/
/test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Next.js generated types
next-env.d.ts
