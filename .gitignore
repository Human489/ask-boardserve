# ---------------------------------------------------------------
# NEVER COMMIT: board data and secrets
# ---------------------------------------------------------------
# Anchored to the repo root: an unanchored "dataset/" also matches
# src/lib/dataset/, which silently drops application code from commits.
/dataset/
/dataset-*/
/data/private/
*.dataset.json

# A zipped dataset is still the dataset. Uploading one leaves an archive lying
# in the working tree, and it is only ever one `git add -A` away from being
# committed. Matching the file suffix cannot catch src/lib/dataset/, so this one
# does not need anchoring.
dataset*.zip

# Environment variables / secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
secrets.json
.wrangler/

# ---------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/
/playwright-report/
/test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Next.js generated types
next-env.d.ts

# Local Claude Code settings: machine-specific, and where tools like impeccable
# write their hooks. launch.json stays tracked — it is the project's own config.
.claude/settings.local.json
.claude/skills/
.claude/agents/
